# Copy to .env and adjust. Never commit .env.
CHRONOS_DATABASE_URL=postgresql://chronos:chronos@localhost:5433/chronosgraph

# Local filesystem roots
CHRONOS_DATA_DIR=data
CHRONOS_CACHE_DIR=data/cache

# Extraction provider (Phase 3). Not required before Phase 3.
CHRONOS_LLM_PROVIDER=
CHRONOS_LLM_MODEL=
CHRONOS_LLM_API_KEY=

# Embeddings (Phase 2/3). Multilingual model, English + Hindi.
CHRONOS_EMBEDDING_MODEL=intfloat/multilingual-e5-base
CHRONOS_EMBEDDING_DIM=768
