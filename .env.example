# Copy to .env and adjust. Never commit .env.
HISTOSEARCH_DATABASE_URL=postgresql://histosearch:histosearch@localhost:5433/histosearch

# Local filesystem roots
HISTOSEARCH_DATA_DIR=data
HISTOSEARCH_CACHE_DIR=data/cache

# Extraction provider (Phase 3). Not required before Phase 3.
HISTOSEARCH_LLM_PROVIDER=
HISTOSEARCH_LLM_MODEL=
HISTOSEARCH_LLM_API_KEY=

# Embeddings (Phase 2/3). Multilingual model, English + Hindi.
HISTOSEARCH_EMBEDDING_MODEL=intfloat/multilingual-e5-base
HISTOSEARCH_EMBEDDING_DIM=768
